<%- include('layout/header') %>

<%
  const productosLocal = Array.isArray(productos) ? productos : [];
%>

<style>
  body {
    background-color: #f8fff9;
  }

  .card {
    background-color: #e9fbe7;
  }

  .datos-cliente-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .datos-cliente-grid .campo-completo {
    grid-column: 1 / -1;
  }

  @media (max-width: 768px) {
    table {
      font-size: 0.9rem;
    }

    .datos-cliente-grid {
      grid-template-columns: 1fr;
    }

    .datos-cliente-grid .campo-completo {
      grid-column: auto;
    }
  }
</style>

<div class="container mt-4">
  <div class="row">

    <!-- IZQUIERDA: CONTROLES DEL VENDEDOR -->
    <div class="col-md-5 mb-3">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">
            <i class="fas fa-cash-register me-2"></i>Punto de venta
          </h5>
        </div>

        <div class="card-body">
          <% if (message) { %>
            <div class="alert alert-dismissible fade show alert-<%= message.type || 'info' %>" role="alert">
              <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Cerrar"></button>
              <strong><%= message.message %></strong>
            </div>
          <% } %>

          <div class="mb-3">
            <label for="tipoCliente" class="form-label">Tipo de cliente</label>
            <select id="tipoCliente" class="form-select">
              <option value="general">General / Mostrador</option>
              <option value="pre-mayoreo">Pre-mayoreo</option>
              <option value="mayoreo">Mayoreo</option>
            </select>
          </div>

          <div id="datosCliente" class="mb-3" hidden>
            <div class="datos-cliente-grid">
              <div class="campo-completo">
                <label for="clienteNombre" class="form-label">Nombre del cliente</label>
                <input type="text" id="clienteNombre" class="form-control" placeholder="Ej. Juan Pérez">
              </div>

              <div>
                <label for="clienteTelefono" class="form-label">Teléfono</label>
                <input type="tel" id="clienteTelefono" class="form-control" inputmode="tel" placeholder="Ej. 4451234567">
              </div>

              <div>
                <label for="clienteDireccion" class="form-label">Dirección / Entrega</label>
                <input type="text" id="clienteDireccion" class="form-control" placeholder="Ej. Av. Hidalgo #123, Centro">
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="productoSelect" class="form-label">Producto</label>
            <select id="productoSelect" class="form-select" <%= productosLocal.length ? '' : 'disabled' %>>
              <% if (productosLocal.length > 0) { %>
                <% productosLocal.forEach(p => { %>
                  <option
                    value="<%= p._id || p.id %>"
                    data-nombre="<%= p.nombre || 'Sin nombre' %>"
                    data-precio="<%= Number(p.precio_venta || 0) %>"
                    data-stock="<%= Number(p.stock || 0) %>"
                    data-unidad="<%= p.unidad || 'kg' %>"
                  >
                    <%= p.nombre || 'Sin nombre' %> - $<%= Number(p.precio_venta || 0).toFixed(2) %> / <%= p.unidad || 'kg' %> (Stock: <%= Number(p.stock || 0) %>)
                  </option>
                <% }) %>
              <% } else { %>
                <option value="">Sin productos disponibles</option>
              <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label for="cantidad" class="form-label">
              Cantidad (<span id="unidadTexto">kg</span>)
            </label>
            <input type="number" id="cantidad" class="form-control" min="0.001" step="0.001" value="1.000">
          </div>

          <div class="mb-3">
            <label for="precioAplicado" class="form-label">Precio unitario aplicado</label>
            <input type="text" id="precioAplicado" class="form-control" value="$0.00" readonly>
            <small class="text-muted" id="textoReglaPrecio">Selecciona producto y cantidad.</small>
          </div>

          <button class="btn btn-success w-100" id="btnAgregar" type="button" <%= productosLocal.length ? '' : 'disabled' %>>
            <i class="fas fa-plus-circle me-1"></i>Agregar a la venta
          </button>
        </div>
      </div>
    </div>

    <!-- DERECHA: CARRITO -->
    <div class="col-md-7 mb-3">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Cuenta del cliente</h5>
          <span class="badge bg-secondary"><%= user ? (user.name || user.username || '') : '' %></span>
        </div>

        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover align-middle text-center" id="tablaVenta">
              <thead class="table-success">
                <tr>
                  <th>Producto</th>
                  <th>Cant.</th>
                  <th>Precio</th>
                  <th>Subtotal</th>
                  <th></th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>

          <div id="carritoVacio" class="text-center text-muted py-3">
            No hay productos agregados.
          </div>

          <h3 class="text-end mt-3">
            Total: $<span id="totalGeneral">0.00</span>
          </h3>

          <form id="formVenta" action="/ventas" method="POST">
            <input type="hidden" name="tipoCliente" id="inputTipoCliente">
            <input type="hidden" name="clienteNombre" id="inputClienteNombre">
            <input type="hidden" name="clienteTelefono" id="inputClienteTelefono">
            <input type="hidden" name="clienteDireccion" id="inputClienteDireccion">
            <input type="hidden" name="carrito" id="inputCarrito">

            <button type="submit" class="btn btn-primary w-100 mt-3" id="btnProcesar" disabled>
              Procesar e imprimir venta
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const tipoCliente = document.getElementById('tipoCliente');
  const datosCliente = document.getElementById('datosCliente');
  const clienteNombre = document.getElementById('clienteNombre');
  const clienteTelefono = document.getElementById('clienteTelefono');
  const clienteDireccion = document.getElementById('clienteDireccion');

  const productoSelect = document.getElementById('productoSelect');
  const cantidadInput = document.getElementById('cantidad');
  const unidadTexto = document.getElementById('unidadTexto');
  const precioAplicado = document.getElementById('precioAplicado');
  const textoReglaPrecio = document.getElementById('textoReglaPrecio');
  const btnAgregar = document.getElementById('btnAgregar');

  const tablaBody = document.querySelector('#tablaVenta tbody');
  const carritoVacio = document.getElementById('carritoVacio');
  const totalGeneralSpan = document.getElementById('totalGeneral');
  const btnProcesar = document.getElementById('btnProcesar');

  const inputTipoCliente = document.getElementById('inputTipoCliente');
  const inputClienteNombre = document.getElementById('inputClienteNombre');
  const inputClienteTelefono = document.getElementById('inputClienteTelefono');
  const inputClienteDireccion = document.getElementById('inputClienteDireccion');
  const inputCarrito = document.getElementById('inputCarrito');
  const formVenta = document.getElementById('formVenta');

  let carrito = [];

  function numeroSeguro(valor) {
    const numero = Number(valor);
    return Number.isFinite(numero) ? numero : 0;
  }

  function redondearDinero(valor) {
    return Math.round((numeroSeguro(valor) + Number.EPSILON) * 100) / 100;
  }

  function obtenerReglaPrecio(precioBase, cantidad, tipoSeleccionado) {
    const base = numeroSeguro(precioBase);
    const cantidadNumerica = numeroSeguro(cantidad);

    let multiplicador = 1;
    let categoria = 'general';
    let mensaje = 'Precio GENERAL aplicado.';

    // El tipo seleccionado establece el beneficio mínimo del cliente.
    if (tipoSeleccionado === 'mayoreo') {
      multiplicador = 0.80;
      categoria = 'mayoreo';
      mensaje = 'Precio MAYOREO aplicado por tipo de cliente (20% de descuento).';
    } else if (tipoSeleccionado === 'pre-mayoreo') {
      multiplicador = 0.90;
      categoria = 'pre-mayoreo';
      mensaje = 'Precio PRE-MAYOREO aplicado por tipo de cliente (10% de descuento).';
    }

    // La cantidad puede mejorar el precio, pero nunca reducir el beneficio existente.
    if (cantidadNumerica >= 20 && multiplicador > 0.80) {
      multiplicador = 0.80;
      categoria = 'mayoreo';
      mensaje = 'Precio MAYOREO aplicado por cantidad de 20 o más.';
    } else if (cantidadNumerica >= 10 && multiplicador > 0.90) {
      multiplicador = 0.90;
      categoria = 'pre-mayoreo';
      mensaje = 'Precio PRE-MAYOREO aplicado por cantidad de 10 a 19.999.';
    }

    return {
      precioUnitario: redondearDinero(base * multiplicador),
      multiplicador,
      categoria,
      mensaje
    };
  }

  function obtenerOpcionSeleccionada() {
    return productoSelect && productoSelect.selectedOptions
      ? productoSelect.selectedOptions[0]
      : null;
  }

  function actualizarUnidad() {
    const option = obtenerOpcionSeleccionada();
    unidadTexto.textContent = option?.dataset.unidad || 'kg';
  }

  function actualizarPreviewPrecio() {
    const option = obtenerOpcionSeleccionada();

    if (!option || !option.value) {
      precioAplicado.value = '$0.00';
      textoReglaPrecio.textContent = 'No hay un producto válido seleccionado.';
      return;
    }

    const cantidad = numeroSeguro(cantidadInput.value);

    if (cantidad <= 0) {
      precioAplicado.value = '$0.00';
      textoReglaPrecio.textContent = 'Ingresa una cantidad mayor que cero.';
      return;
    }

    const regla = obtenerReglaPrecio(
      option.dataset.precio,
      cantidad,
      tipoCliente.value
    );

    precioAplicado.value = `$${regla.precioUnitario.toFixed(2)}`;
    textoReglaPrecio.textContent = regla.mensaje;
    actualizarUnidad();
  }

  function recalcularCarrito() {
    carrito = carrito.map(item => {
      const regla = obtenerReglaPrecio(
        item.precioBase,
        item.cantidad,
        tipoCliente.value
      );

      return {
        ...item,
        precioUnitario: regla.precioUnitario,
        categoriaPrecio: regla.categoria,
        subtotal: redondearDinero(item.cantidad * regla.precioUnitario)
      };
    });

    renderCarrito();
  }

  function renderCarrito() {
    tablaBody.replaceChildren();
    let total = 0;

    carrito.forEach((item, index) => {
      total += item.subtotal;

      const tr = document.createElement('tr');

      const tdProducto = document.createElement('td');
      tdProducto.textContent = item.nombre;

      const tdCantidad = document.createElement('td');
      tdCantidad.textContent = `${item.cantidad.toFixed(3)} ${item.unidad}`;

      const tdPrecio = document.createElement('td');
      tdPrecio.textContent = `$${item.precioUnitario.toFixed(2)}`;

      const tdSubtotal = document.createElement('td');
      tdSubtotal.textContent = `$${item.subtotal.toFixed(2)}`;

      const tdAcciones = document.createElement('td');
      const botonEliminar = document.createElement('button');
      botonEliminar.type = 'button';
      botonEliminar.className = 'btn btn-sm btn-outline-danger';
      botonEliminar.dataset.index = String(index);
      botonEliminar.setAttribute('aria-label', `Eliminar ${item.nombre}`);
      botonEliminar.innerHTML = '<i class="fas fa-times"></i>';
      tdAcciones.appendChild(botonEliminar);

      tr.append(tdProducto, tdCantidad, tdPrecio, tdSubtotal, tdAcciones);
      tablaBody.appendChild(tr);
    });

    totalGeneralSpan.textContent = redondearDinero(total).toFixed(2);
    inputCarrito.value = JSON.stringify(carrito);
    carritoVacio.hidden = carrito.length > 0;
    btnProcesar.disabled = carrito.length === 0;
  }

  tipoCliente.addEventListener('change', () => {
    const esGeneral = tipoCliente.value === 'general';
    datosCliente.hidden = esGeneral;

    if (esGeneral) {
      clienteNombre.value = 'Mostrador';
      clienteTelefono.value = '';
      clienteDireccion.value = '';
    } else if (clienteNombre.value === 'Mostrador') {
      clienteNombre.value = '';
    }

    actualizarPreviewPrecio();
    recalcularCarrito();
  });

  productoSelect.addEventListener('change', () => {
    actualizarUnidad();
    actualizarPreviewPrecio();
  });

  cantidadInput.addEventListener('input', actualizarPreviewPrecio);

  tablaBody.addEventListener('click', event => {
    const boton = event.target.closest('button[data-index]');
    if (!boton) return;

    const index = Number(boton.dataset.index);
    if (!Number.isInteger(index) || !carrito[index]) return;

    carrito.splice(index, 1);
    renderCarrito();
  });

  btnAgregar.addEventListener('click', () => {
    const option = obtenerOpcionSeleccionada();

    if (!option || !option.value) {
      alert('Selecciona un producto válido.');
      return;
    }

    const stock = numeroSeguro(option.dataset.stock);
    const cantidadNueva = numeroSeguro(cantidadInput.value);
    const precioBase = numeroSeguro(option.dataset.precio);
    const unidad = option.dataset.unidad || 'kg';
    const nombre = option.dataset.nombre || 'Producto';

    if (cantidadNueva <= 0) {
      alert('Ingresa una cantidad mayor que cero.');
      cantidadInput.focus();
      return;
    }

    if (stock <= 0) {
      alert(`❌ No hay stock disponible de ${nombre}.`);
      return;
    }

    const index = carrito.findIndex(item => item.productId === option.value);
    const cantidadExistente = index >= 0 ? carrito[index].cantidad : 0;
    const cantidadAcumulada = redondearDinero(cantidadExistente + cantidadNueva);

    if (cantidadAcumulada > stock) {
      alert(`❌ No puedes vender más de lo disponible. Stock: ${stock} ${unidad}. En el carrito: ${cantidadExistente.toFixed(3)} ${unidad}.`);
      return;
    }

    const regla = obtenerReglaPrecio(
      precioBase,
      cantidadAcumulada,
      tipoCliente.value
    );

    if (index >= 0) {
      carrito[index] = {
        ...carrito[index],
        cantidad: cantidadAcumulada,
        precioBase,
        precioUnitario: regla.precioUnitario,
        categoriaPrecio: regla.categoria,
        subtotal: redondearDinero(cantidadAcumulada * regla.precioUnitario)
      };
    } else {
      carrito.push({
        productId: option.value,
        nombre,
        cantidad: cantidadAcumulada,
        unidad,
        precioBase,
        precioUnitario: regla.precioUnitario,
        categoriaPrecio: regla.categoria,
        subtotal: redondearDinero(cantidadAcumulada * regla.precioUnitario)
      });
    }

    if (stock - cantidadAcumulada <= 3) {
      alert(`⚠️ Después de esta venta quedarían ${(stock - cantidadAcumulada).toFixed(3)} ${unidad} de ${nombre}.`);
    }

    renderCarrito();
    actualizarPreviewPrecio();
  });

  formVenta.addEventListener('submit', event => {
    if (carrito.length === 0) {
      event.preventDefault();
      alert('No hay productos en la venta.');
      return;
    }

    const esGeneral = tipoCliente.value === 'general';

    inputTipoCliente.value = tipoCliente.value;
    inputClienteNombre.value = esGeneral
      ? 'Mostrador'
      : (clienteNombre.value.trim() || 'Cliente sin nombre');
    inputClienteTelefono.value = esGeneral
      ? ''
      : (clienteTelefono.value.trim() || 'Sin teléfono');
    inputClienteDireccion.value = esGeneral
      ? ''
      : (clienteDireccion.value.trim() || 'Sin dirección');
    inputCarrito.value = JSON.stringify(carrito);

    btnProcesar.disabled = true;
    btnProcesar.textContent = 'Procesando venta...';
  });

  tipoCliente.dispatchEvent(new Event('change'));
  actualizarUnidad();
  actualizarPreviewPrecio();
  renderCarrito();
});
</script>

<%- include('layout/footer') %>