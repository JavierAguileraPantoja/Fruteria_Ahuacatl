<%- include('partials/_header') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users"></i> Directorio de Clientes</h2>
        <span class="badge bg-primary">Total: <%= clients.length %></span>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Total Gastado</th>
                            <th>Última Compra</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (clients.length > 0) { %>
                            <% clients.forEach(client => { %>
                                <tr>
                                    <td><strong><%= client.name %></strong></td>
                                    <td><%= client.phone %></td>
                                    <td>$<%= client.totalSpent.toFixed(2) %></td>
                                    <td><%= new Date(client.lastPurchase).toLocaleDateString() %></td>
                                    <td class="text-center">
                                        <a href="https://wa.me/<%= client.phone %>?text=Hola%20<%= client.name %>,%20tenemos%20producto%20fresco%20en%20Frutería%20Ahuacatl" 
                                           target="_blank" 
                                           class="btn btn-success btn-sm">
                                            <i class="fab fa-whatsapp"></i> Enviar Aviso
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center text-muted">No hay clientes registrados aún.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('partials/_footer') %>