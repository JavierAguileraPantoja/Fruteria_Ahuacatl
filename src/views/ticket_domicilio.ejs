<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { box-sizing: border-box; }
        body { 
            width: 58mm; 
            margin: 0; 
            padding: 0; 
            font-family: 'Courier New', Courier, monospace; 
            font-size: 12px; 
            line-height: 1.2;
        }
        .ticket { padding: 3mm; width: 58mm; }
        .centrado { text-align: center; }
        .bold { font-weight: bold; }
        .separador { border-top: 1px dashed #000; margin: 5px 0; }
        .items { width: 100%; }
        .direccion { 
            background: #eee; 
            padding: 5px; 
            font-size: 13px; 
            border: 1px solid #000;
        }
        @media print { 
            .no-print { display: none; } 
            @page { margin: 0; }
        }
    </style>
</head>
<body onload="window.print();">
    <div class="ticket">
        <div class="centrado bold">
            *** AHUACATL ***<br>
            PEDIDO A DOMICILIO
        </div>
        <div class="separador"></div>

        <div class="bold">CLIENTE:</div>
        <%= venta.clienteNombre %><br>
        <%= venta.clienteTelefono %>
        
        <div class="separador"></div>
        <div class="bold">DIRECCIÓN DE ENVÍO:</div>
        <div class="direccion">
            <%= venta.notas || 'Dirección no especificada' %>
        </div>
        <div class="separador"></div>

        <div class="bold">PEDIDO:</div>
        <table class="items">
            <% venta.items.forEach(item => { %>
                <tr>
                    <td>[ ] <%= item.cantidad %> <%= item.unidad %></td>
                    <td align="right"><%= item.nombre %></td>
                </tr>
            <% }) %>
        </table>

        <div class="separador"></div>
        <div class="total centrado bold" style="font-size: 14px;">
            TOTAL A COBRAR: $<%= venta.total %>
        </div>
        
        <div class="centrado" style="margin-top: 10px; font-size: 10px;">
            Vendedor: <%= venta.creadoBy %><br>
            <%= new Date(venta.creadoEn).toLocaleString() %>
        </div>
    </div>

    <div class="no-print" style="margin-top: 20px; text-align: center;">
        <button onclick="window.print()">Re-imprimir</button>
        <a href="/ventas">Volver a Ventas</a>
    </div>
</body>
</html>